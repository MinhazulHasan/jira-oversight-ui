# Copy to .env.local and fill in. Every value here is read on the server only.
# Nothing in this file may carry a NEXT_PUBLIC_ prefix: that would inline it
# into the browser bundle, where every viewer could read it.
# Values shown are what this project runs with. Fill in the four secrets
# (OVERSIGHT_SERVICE_KEY, ATLASSIAN_CLIENT_ID, ATLASSIAN_CLIENT_SECRET,
# AUTH_SECRET); leave the other blanks empty.

# Where the figures come from: "sample" (the bundled, labelled DEMO project)
# or "live" (the oversight dashboard API below).
OVERSIGHT_DATA=live

# The oversight dashboard API (FastAPI). Used in live mode only.
OVERSIGHT_API_URL=http://localhost:3300

# The credential this interface presents to the API. Server-side only; it
# never reaches the browser. Take it from the API's own configuration.
OVERSIGHT_SERVICE_KEY=

# The Jira site, for "Open in Jira" links in live mode,
# for example https://your-site.atlassian.net. With sign-in on it is required:
# every account must be able to reach this site, and sessions are sealed for
# it, so changing it signs everyone out.
OVERSIGHT_JIRA_BASE_URL=

# ---------------------------------------------------------------- sign-in --
# Sign in with Atlassian (OAuth 2.0 three-legged). "atlassian" or "off".
# Empty: on when OVERSIGHT_DATA=live, off for the sample, which has nothing to
# protect. When it is on and anything below is missing or wrong, nobody gets
# in and /login names the variable to fix.
AUTH_MODE=

# The address the dashboard is served from, origin only, for example
# https://oversight.example.com (http only for localhost or 127.0.0.1). Open
# the dashboard at exactly this address. Register the callback URL with the
# Atlassian app as this address followed by /api/auth/callback, for example
# http://localhost:3400/api/auth/callback.
APP_URL=http://localhost:3400

# From the Atlassian developer console (developer.atlassian.com/console/myapps):
# the app's Settings page. Scopes to add under Permissions: read:me (User
# Identity API) and read:jira-work (Jira API). Nothing that writes.
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# Seals the session cookies: at least 32 characters of random, for example
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out, everywhere. (Sign out ends the session in
# the browser it is pressed in; the server keeps no list of sessions.)
AUTH_SECRET=

# Email domains allowed in, comma-separated, for example
# example.com,example.org. Exact match on the part after the last
# "@": no wildcards, and a subdomain needs its own entry. Taking a domain off
# signs its people out at once.
ALLOWED_EMAIL_DOMAINS=

# Who is an admin: "everyone-admin" or "admin-list". Admins see every board
# this dashboard covers, whatever their own Jira lets them open, and people
# level: Ask about people, the People page, person cards, and Governance
# (access log, usage, rule settings). The access log still records who viewed
# whose figures.
#   everyone-admin  everyone who signs in is an admin (sign-in still admits
#                   only ALLOWED_EMAIL_DOMAINS). The default when empty.
#   admin-list      only the addresses in ADMIN_EMAILS are admins; everyone
#                   else sees only the boards their Jira account can open.
ACCESS_MODE=

# Admins under ACCESS_MODE=admin-list: the PMs and POs who oversee the work.
# Email addresses, comma-separated, each on a domain in ALLOWED_EMAIL_DOMAINS,
# for example lead@example.com. Adding or removing an address
# takes effect when the dashboard restarts; no one needs to sign in again.
# Empty: no admins. Ignored with everyone-admin, but still checked.
ADMIN_EMAILS=

# Tests only: a local stand-in for Atlassian's servers (https, or http on
# localhost or 127.0.0.1). Leave empty. npm run e2e:auth sets its own sign-in
# values for its servers, whatever this file says.
ATLASSIAN_AUTH_URL=
ATLASSIAN_API_URL=

# Sample mode only: pin "now" (ISO 8601, UTC) so "this week" and relative
# times are the same on every run, for screenshots and tests.
# Example: 2026-11-04T14:30:00Z
SAMPLE_NOW=

# Sample mode only: artificial response delay in milliseconds, to see the
# loading states. 0 or empty for none.
SAMPLE_LATENCY=

# Sample mode only: whether people may be compared side by side on the People
# page and in Ask (the sample's stand-in for the service's PEOPLE_COMPARISON).
# on (the default) or off; set it to off only to see what an organisation
# that does not want people compared would see.
SAMPLE_PEOPLE_COMPARISON=
