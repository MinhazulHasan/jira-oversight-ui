# Copy to .env.local and fill in. Server-side only: never use a NEXT_PUBLIC_ prefix.

# Data source: sample (bundled demo) or live (the oversight API).
OVERSIGHT_DATA=live
OVERSIGHT_API_URL=http://localhost:3300
# Same value as API_SERVICE_KEY in the backend.
OVERSIGHT_SERVICE_KEY=
# Jira site for "Open in Jira" links, e.g. https://your-site.atlassian.net. Required with sign-in.
OVERSIGHT_JIRA_BASE_URL=

# Sign-in
# atlassian or off. Empty: on for live data, off for the sample.
AUTH_MODE=
# The dashboard's address (origin only). Atlassian callback: <APP_URL>/api/auth/callback.
APP_URL=http://localhost:3400
# Atlassian app credentials (scopes: read:me, read:jira-work).
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# At least 32 random characters. Changing it signs everyone out.
AUTH_SECRET=
# Comma-separated email domains allowed to sign in, e.g. example.com.
ALLOWED_EMAIL_DOMAINS=
# everyone-admin (default) or admin-list (only ADMIN_EMAILS are admins).
ACCESS_MODE=
# Comma-separated admin emails, used with ACCESS_MODE=admin-list.
ADMIN_EMAILS=

# Tests only: leave empty.
ATLASSIAN_AUTH_URL=
ATLASSIAN_API_URL=

# Sample mode only
# Pin "now" (ISO 8601, UTC), e.g. 2026-11-04T14:30:00Z.
SAMPLE_NOW=
# Response delay in milliseconds.
SAMPLE_LATENCY=
# on (default) or off.
SAMPLE_PEOPLE_COMPARISON=
